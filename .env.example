# ==============================================================================
# UTEHub TechDocs (doc.utehub.vn) - Environment Variables Template
# ==============================================================================
# IMPORTANT:
# - Do NOT commit real secrets or production keys to version control.
# - In accordance with LEAST PRIVILEGE: Service Role keys are NOT included here.
#   All client and server user operations must run under Supabase RLS.
# ==============================================================================

# Supabase Project URL (Public)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Publishable / Anon Key (Public, restricted strictly by RLS)
# Official Supabase SSR standard naming:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Compatibility fallback for legacy codebase / existing Supabase project setups:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Application Base Path (Optional, default is empty)
NEXT_PUBLIC_BASE_PATH=
